# 复制为服务器项目根目录下的 .env，填写真实密钥；.env 已被 Git 忽略。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 本地语音：SenseVoiceSmall 或 faster-whisper 模型目录；相对路径以项目根目录为准。
CHZ_ASR_MODEL=./models/SenseVoiceSmall
# 可选真人面试网络服务；逗号分隔多个STUN/TURN地址，不配置时仅尝试直连。
INTERVIEW_STUN_URLS=
INTERVIEW_TURN_URLS=
# 与coturn的static-auth-secret一致，至少16字符；只在服务器保存。
INTERVIEW_TURN_SECRET=
INTERVIEW_TURN_TTL=600

# 语音模型目录可在本文件或进程环境配置；进程环境优先，兼容旧 CHZ_WHISPER_MODEL。
# 使用 systemd 时，可让已有服务的 EnvironmentFile 指向本项目 .env。
